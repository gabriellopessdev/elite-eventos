generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANIZER
  CUSTOMER
  DOOR
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  role          Role
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  events        Event[]
  heldSeats     Seat[]
  tickets       Ticket[]

  @@map("users")
}

// Opaque refresh (como Linky ADR-003): só hash no DB; rotação a cada uso; reuse → revoga família.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([familyId])
  @@map("refresh_tokens")
}

// TMDb é catálogo; Event é a sessão vendável (ADR-004). title/posterPath = snapshot.
enum SeatStatus {
  AVAILABLE
  HELD
  SOLD
}

enum EventStatus {
  PUBLISHED
  ARCHIVED
}

enum TicketStatus {
  UNUSED
  USED
  EXPIRED
}

model Event {
  id          String      @id @default(uuid())
  tmdbId      Int         @map("tmdb_id")
  title       String
  posterPath  String?     @map("poster_path")
  startsAt    DateTime    @map("starts_at")
  priceCents  Int         @map("price_cents")
  organizerId String      @map("organizer_id")
  status      EventStatus @default(PUBLISHED)
  createdAt   DateTime    @default(now()) @map("created_at")

  organizer User     @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  seats     Seat[]
  tickets   Ticket[]

  @@index([startsAt])
  @@index([organizerId])
  @@map("events")
}

// Grade nasce no create do evento, todos AVAILABLE. Hold/TTL (heldBy, heldUntil) em feat/seat-hold.
model Seat {
  id        String     @id @default(uuid())
  eventId   String     @map("event_id")
  row       String
  number    Int
  status    SeatStatus @default(AVAILABLE)
  heldById  String?    @map("held_by_id")
  heldUntil DateTime?  @map("held_until")

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  heldBy User?   @relation(fields: [heldById], references: [id], onDelete: SetNull)
  ticket Ticket?

  @@unique([eventId, row, number])
  @@index([eventId, status])
  @@map("seats")
}

model Ticket {
  id        String       @id @default(uuid())
  eventId   String       @map("event_id")
  seatId    String       @unique @map("seat_id")
  userId    String       @map("user_id")
  code      String
  pin       String
  status    TicketStatus @default(UNUSED)
  createdAt DateTime     @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  seat  Seat  @relation(fields: [seatId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventId, pin])
  @@index([userId, createdAt])
  @@index([eventId])
  @@map("tickets")
}
